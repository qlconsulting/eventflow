{
  "manifest_version": 3,
  "name": "PlugThis.ai — The Leverage Lab",
  "description": "Executive lead capture, research, and content drafting via The Leverage Lab Worker.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PlugThis.ai"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/serviceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://api.theleveragelab.com/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "icons": {}
}
