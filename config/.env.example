# Copy to cloudflare-worker/.dev.vars for local `wrangler dev`
# Never commit .dev.vars or real API keys.

TEABLE_API_KEY=
RETRIEVER_API_KEY=
KATTEB_API_KEY=
QOLABA_API_KEY=
FUSE_API_KEY=
JWT_SECRET=
DASHFORM_WEBHOOK_SECRET=

# Optional local overrides (also settable via wrangler [vars])
ENVIRONMENT=development
API_BASE_URL=http://127.0.0.1:8787
ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID,http://localhost:5173
TEABLE_MASTER_BASE_ID=
TEABLE_MASTER_TABLE_ID=
