# Copy to cloudflare-worker/.dev.vars for local `wrangler dev`
# Never commit .dev.vars or real API keys.
# Fill Teable IDs from Teable's implementation dump (see teable-ids.example.json).

# --- Secrets ---
TEABLE_API_KEY=
RETRIEVER_API_KEY=
KATTEB_API_KEY=
QOLABA_API_KEY=
FUSE_API_KEY=
JWT_SECRET=
DASHFORM_WEBHOOK_SECRET=

# --- Public / non-secret ---
ENVIRONMENT=development
API_BASE_URL=http://127.0.0.1:8787
ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID,http://localhost:5173,https://lab.theleveragelab.com
LAB_DASHBOARD_URL=https://lab.theleveragelab.com
DEFAULT_TIMEZONE=America/Los_Angeles

# Master Control Base + [TEMPLATE] Executive Workspace
TEABLE_MASTER_BASE_ID=
TEABLE_TEMPLATE_BASE_ID=

# Master Control tables
TEABLE_EXECUTIVE_DIRECTORY_TABLE_ID=
TEABLE_PROVISIONING_LOG_TABLE_ID=
TEABLE_MASTER_PROMPT_TEMPLATES_TABLE_ID=
TEABLE_TONE_PERSONA_MATRIX_TABLE_ID=
TEABLE_GLOBAL_SYSTEM_VARIABLES_TABLE_ID=

# Template-base table IDs (used after clone; may need name resolution if IDs change)
TEABLE_TMPL_CLIENT_PROFILE_TABLE_ID=
TEABLE_TMPL_PROMPT_LIBRARY_TABLE_ID=
TEABLE_TMPL_INBOX_LEADS_TABLE_ID=
TEABLE_TMPL_RESEARCH_RUNS_TABLE_ID=
TEABLE_TMPL_THOUGHT_LEADERSHIP_TABLE_ID=
TEABLE_TMPL_OUTREACH_QUEUE_TABLE_ID=
TEABLE_TMPL_ASSET_LIBRARY_TABLE_ID=
TEABLE_TMPL_AUTOMATION_LOG_TABLE_ID=
TEABLE_TMPL_WEB_PROPERTIES_TABLE_ID=
